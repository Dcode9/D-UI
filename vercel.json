{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/windows",
      "destination": "https://apps.microsoft.com/detail/9P4W2JHQ03N1",
      "permanent": false
    },
    {
      "source": "/android",
      "destination": "https://play.google.com/store/apps/details?id=com.dcode9.dtunes",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/d-tunes_logo", "destination": "/d-tunes_logo.html" },
    { "source": "/components", "destination": "/components.html" },
    { "source": "/studio", "destination": "/studio.html" },
    { "source": "/studio.html", "destination": "/studio.html" },
    { "source": "/d-tunes", "destination": "/d-tunes/index.html" },
    { "source": "/d-tunes/(.*)", "destination": "/d-tunes/$1" },
    { "source": "/api/(.*)", "destination": "/api/index.js" }
  ]
}
